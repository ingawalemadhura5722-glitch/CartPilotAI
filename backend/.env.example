# Copy this file to ".env" (Copy-Item .env.example .env) and edit if needed.
# The real ".env" file is ignored by Git, so secrets never get committed.

# Comma-separated list of frontend URLs allowed to call this API (CORS).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. If you leave this out, a SQLite file called cartpilot.db
# is created inside the backend folder automatically.
# DATABASE_URL=sqlite:///./cartpilot.db

# ---------------------------------------------------------------
# NOT USED ON DAY 1. These are reserved for later days.
# Keep real keys ONLY here in the backend, never in frontend code.
# ---------------------------------------------------------------
# GEMINI_API_KEY=
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
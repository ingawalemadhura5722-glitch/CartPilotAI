# Copy this file to ".env" (Copy-Item .env.example .env) and edit it.
# The real ".env" file is ignored by Git, so secrets never get committed.

# Comma-separated list of frontend URLs allowed to call this API (CORS).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. If you leave this out, a SQLite file called cartpilot.db
# is created inside the backend folder automatically.
# DATABASE_URL=sqlite:///./cartpilot.db

# ---------------- Gemini AI ----------------
# Get a key at https://aistudio.google.com/apikey  (backend only, never in the frontend)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=40

# ---------------- PayPal SANDBOX (Day 3) ----------------
# From developer.paypal.com > Apps & Credentials > Sandbox. Backend only!
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
# Must be the Sandbox URL. The app refuses to start payments with any other URL.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_TIMEOUT_SECONDS=20

# PayPal does not accept INR here, so the backend converts the INR total to USD
# using this FIXED DEMO rate (rupees per 1 US dollar). It is NOT a live exchange rate.
PAYPAL_DEMO_INR_PER_USD=85

# Where PayPal sends the customer after approving or cancelling (the React app).
FRONTEND_BASE_URL=http://localhost:5173